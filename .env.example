# Expo Web local backend:
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8081
#
# Expo Go on Android emulator:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8081
#
# Expo Go on a physical phone:
# EXPO_PUBLIC_API_BASE_URL=http://YOUR_PC_LAN_IP:8081
EXPO_PUBLIC_API_BASE_URL=http://192.168.88.22:8081

# Native maps use the bundled Leaflet WebView; no map SDK key is required.
# Optional web tile provider, using Leaflet {z}/{x}/{y} URL placeholders.
# EXPO_PUBLIC_MAP_TILE_URL=
# EXPO_PUBLIC_MAP_ATTRIBUTION=
