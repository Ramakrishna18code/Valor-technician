{
  "expo": {
    "name": "Valor Technician",
    "slug": "valor-technician",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "valortechnician",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Valor uses your location only while an active assigned job is open so customers can see your latest job location.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Valor uses background location only while an active assigned job is being serviced.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "versionCode": 3,
      "allowBackup": false,
      "package": "com.valor.technician",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/valor-launcher-foreground.png",
        "backgroundColor": "#F4F8FC"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Valor uses your location only while an active assigned job is open so customers can see your latest job location.",
          "locationAlwaysAndWhenInUsePermission": "Valor uses background location only while an active assigned job is being serviced.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    },
    "splash": {
      "image": "./assets/valor-company-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FBFF"
    },
    "extra": {
      "eas": {
        "projectId": "6de23c69-aec7-437b-9887-ad3f4581834b"
      }
    },
    "icon": "./assets/valor-launcher.png"
  }
}
